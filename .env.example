# Server Port
PORT=8000

# MongoDB Connection String (Atlas / Railway / Render / Local)
DB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/<database>?retryWrites=true&w=majority
# Alternatively:
# MONGODB_URI=mongodb://localhost:27017/expense_tracker

# JWT Secret for authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend / Client Origin for CORS (e.g. your Vercel or Netlify frontend URL)
FRONTEND_URL=http://localhost:5173
# Alternatively specify comma-separated origins:
# ALLOWED_ORIGINS=http://localhost:5173,https://my-expense-tracker.vercel.app

# Environment
NODE_ENV=development
